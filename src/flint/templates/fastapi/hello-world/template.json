{
  "id": "hello-world",
  "label": "Hello World",
  "description": "A minimal FastAPI app with a single Hello World endpoint, managed with uv.",
  "enabled": true,
  "options": [
    {
      "key": "config",
      "label": "Add configuration (pydantic-settings)?",
      "type": "confirm",
      "default": false
    }
  ],
  "layers": [
    { "dir": "docker", "when": { "docker": [true] } },
    { "dir": "compose", "when": { "compose": [true] } },
    { "dir": "config", "when": { "config": [true] } }
  ]
}
