services:
  app:
    build: .
    ports:
      - "8000:8000"
    env_file:
      - .env
{% if database == "postgres" or redis or broker == "rabbitmq" %}
    environment:
{% if database == "postgres" %}
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@db:5432/{{ package_name }}
{% endif %}
{% if redis %}
      REDIS_URL: redis://redis:6379/0
{% endif %}
{% if broker == "rabbitmq" %}
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672//
{% endif %}
{% endif %}
{% if database == "postgres" or redis or broker == "rabbitmq" %}
    depends_on:
{% if database == "postgres" %}
      - db
{% endif %}
{% if redis %}
      - redis
{% endif %}
{% if broker == "rabbitmq" %}
      - rabbitmq
{% endif %}
{% endif %}
{% if worker != "none" %}

  worker:
    build: .
{% if worker == "taskiq" %}
    command: ["uv", "run", "taskiq", "worker", "{{ package_name }}.worker:broker", "--app-dir", "src"]
{% elif worker == "celery" %}
    command: ["uv", "run", "celery", "-A", "{{ package_name }}.worker.celery_app", "worker", "--loglevel=info"]
{% endif %}
    env_file:
      - .env
    environment:
{% if worker == "celery" %}
      PYTHONPATH: src
{% endif %}
{% if database == "postgres" %}
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@db:5432/{{ package_name }}
{% endif %}
{% if redis %}
      REDIS_URL: redis://redis:6379/0
{% endif %}
{% if broker == "rabbitmq" %}
      RABBITMQ_URL: amqp://guest:guest@rabbitmq:5672//
{% endif %}
    depends_on:
{% if database == "postgres" %}
      - db
{% endif %}
{% if broker == "redis" and redis %}
      - redis
{% elif broker == "rabbitmq" %}
      - rabbitmq
{% endif %}
{% endif %}
{% if database == "postgres" %}

  db:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ package_name }}
    ports:
      - "5432:5432"
    volumes:
      - db-data:/var/lib/postgresql/data
{% endif %}
{% if redis %}

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
{% endif %}
{% if broker == "rabbitmq" %}

  rabbitmq:
    image: rabbitmq:3-management-alpine
    ports:
      - "5672:5672"
      - "15672:15672"
{% endif %}
{% if database == "postgres" %}

volumes:
  db-data:
{% endif %}
