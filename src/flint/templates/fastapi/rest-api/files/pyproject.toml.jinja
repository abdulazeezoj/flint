[project]
name = "{{ slug }}"
version = "0.1.0"
description = "A FastAPI REST API generated by flint."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "fastapi[standard]>=0.115.0",
    "pydantic-settings>=2.6.0",
{% if orm == "sqlmodel" %}
    "sqlmodel>=0.0.22",
{% elif orm == "sqlalchemy" %}
    "sqlalchemy>=2.0.36",
{% endif %}
{% if database == "sqlite" %}
    "aiosqlite>=0.20.0",
{% elif database == "postgres" %}
    "asyncpg>=0.30.0",
{% endif %}
{% if migrations %}
    "alembic>=1.14.0",
{% endif %}
{% if worker == "taskiq" %}
    "taskiq>=0.11.0",
    "taskiq-redis>=1.0.0",
    "taskiq-fastapi>=0.3.0",
{% elif worker == "celery" %}
    "celery>=5.4.0",
{% endif %}
{% if redis %}
    "redis>=5.2.0",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3.4",
    "httpx>=0.28.0",
{% if database != "none" %}
    "pytest-asyncio>=0.24.0",
    "aiosqlite>=0.20.0",
{% endif %}
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["src"]
{% if database != "none" %}
asyncio_mode = "auto"
{% endif %}
