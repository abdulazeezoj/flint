from celery import Celery

from {{ package_name }}.core.config import settings

{% if broker == "rabbitmq" %}
celery_app = Celery("{{ package_name }}", broker=settings.rabbitmq_url, backend="rpc://")
{% else %}
celery_app = Celery("{{ package_name }}", broker=settings.redis_url, backend=settings.redis_url)
{% endif %}

# Imported last, after `celery_app` exists: every module in tasks/ needs
# `celery_app` to register its `@celery_app.task`-decorated functions,
# and the worker process only discovers those tasks by importing the
# module that defines them — so every new tasks/ module goes on a line
# here too.
from {{ package_name }}.tasks import example  # noqa: E402,F401
