{
  "id": "hello-world",
  "label": "Hello World",
  "description": "A minimal Flask app with a single Hello World endpoint, managed with uv.",
  "enabled": true,
  "options": [
    {
      "key": "config",
      "label": "Add configuration (pydantic-settings)?",
