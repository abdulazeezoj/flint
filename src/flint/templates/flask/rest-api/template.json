{
  "id": "rest-api",
  "label": "REST API",
  "description": "A layered Flask REST API with pydantic-settings, and your choice of database/ORM, migrations, and a Celery background worker (Redis or RabbitMQ) with optional Redis caching.",
  "enabled": true,
  "options": [
    {
      "key": "database",
      "label": "Database",
      "type": "select",
      "default": "sqlite",
      "choices": [
        { "value": "none", "label": "None (in-memory store)" },
        { "value": "sqlite", "label": "SQLite" },
        { "value": "postgres", "label": "PostgreSQL" }
      ]
    },
    {
      "key": "orm",
      "label": "ORM",
      "type": "select",
      "default": "flask-sqlalchemy",
      "choices": [
        { "value": "flask-sqlalchemy", "label": "Flask-SQLAlchemy" },
        { "value": "sqlalchemy", "label": "SQLAlchemy (manual)" }
      ],
      "when": { "database": ["sqlite", "postgres"] },
      "skip_value": "none"
    },
    {
      "key": "migrations",
      "label": "Add Flask-Migrate/Alembic migrations?",
      "type": "confirm",
      "default": true,
      "when": { "database": ["sqlite", "postgres"] },
      "skip_value": false
    },
    {
      "key": "worker",
      "label": "Background worker",
      "type": "select",
      "default": "none",
      "choices": [
        { "value": "none", "label": "None" },
        { "value": "celery", "label": "Celery" }
      ]
    },
    {
      "key": "broker",
      "label": "Message broker",
      "type": "select",
      "default": "redis",
      "choices": [
        { "value": "redis", "label": "Redis" },
        { "value": "rabbitmq", "label": "RabbitMQ" }
      ],
      "when": { "worker": ["celery"] },
      "skip_value": "none"
    },
    {
      "key": "redis",
      "label": "Add Redis (caching)?",
      "type": "confirm",
      "default": false,
      "when": { "broker": ["rabbitmq", "none"] },
      "skip_value": true
    }
  ],
  "layers": [
    { "dir": "docker", "when": { "docker": [true] } },
    { "dir": "db-flask-sqlalchemy", "when": { "orm": ["flask-sqlalchemy"] } },
    { "dir": "db-sqlalchemy", "when": { "orm": ["sqlalchemy"] } },
    { "dir": "migrations-flask-sqlalchemy", "when": { "orm": ["flask-sqlalchemy"], "migrations": [true] } },
    { "dir": "migrations-sqlalchemy", "when": { "orm": ["sqlalchemy"], "migrations": [true] } },
    { "dir": "worker-celery", "when": { "worker": ["celery"] } },
    { "dir": "redis", "when": { "redis": [true] } }
  ]
}
