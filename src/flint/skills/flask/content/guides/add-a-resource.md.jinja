Create `src/{{ package_name }}/routes/widgets.py`:

```python
from flask import Blueprint, jsonify, request
from pydantic import ValidationError
{% if orm == "sqlalchemy" %}
from sqlalchemy import select
{% endif %}

{% if database != "none" %}
from {{ package_name }}.core.db import {% if orm == "flask-sqlalchemy" %}db{% else %}get_session{% endif %}
from {{ package_name }}.models import Widget
{% endif %}
from {{ package_name }}.schemas import WidgetCreate, WidgetRead

bp = Blueprint("widgets", __name__, url_prefix="/widgets")


@bp.get("/")
def list_widgets():
{% if orm == "flask-sqlalchemy" %}
    widgets = db.session.execute(db.select(Widget)).scalars().all()
{% elif orm == "sqlalchemy" %}
    session = get_session()
    widgets = session.execute(select(Widget)).scalars().all()
{% else %}
    ...  # same in-memory-store shape as routes/items.py
{% endif %}
    return jsonify([WidgetRead.model_validate(w).model_dump() for w in widgets])
```

Follow `routes/items.py` for the rest of the CRUD handlers (`POST`,
`GET /<int:widget_id>`, `DELETE /<int:widget_id>`) — same
`ItemCreate.model_validate(request.get_json(force=True, silent=True) or
{})` / `422` shape for validation errors (see
`references/routing-and-blueprints.md`), same status codes (`201` on
create, `204` on delete, `404` via `jsonify({"detail": ...}), 404` when
not found).

