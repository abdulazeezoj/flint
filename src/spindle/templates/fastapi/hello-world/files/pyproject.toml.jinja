[project]
name = "{{ slug }}"
version = "0.1.0"
description = "A FastAPI project generated by spindle."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "fastapi[standard]>=0.115.0",
{% if config %}
    "pydantic-settings>=2.6.0",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3.4",
    "httpx>=0.28.0",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["src"]
