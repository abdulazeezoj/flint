[project]
name = "{{ slug }}"
version = "0.1.0"
description = "A Flask project generated by spindle."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "flask>=3.1.0",
{% if config %}
    "pydantic-settings>=2.6.0",
{% endif %}
{% if docker %}
    "gunicorn>=23.0.0",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3.4",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["src"]
