{% if css == "tailwind" %}
FROM oven/bun:1 AS css-builder

WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install

COPY src/{{ package_name }}/templates src/{{ package_name }}/templates
COPY src/{{ package_name }}/static src/{{ package_name }}/static
RUN bun run build:css

{% endif %}
FROM ghcr.io/astral-sh/uv:python3.11-bookworm-slim

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app/src

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-install-project --no-dev

COPY . .
{% if css == "tailwind" %}
COPY --from=css-builder /app/src/{{ package_name }}/static/css/style.css src/{{ package_name }}/static/css/style.css
{% endif %}
RUN uv sync --no-dev

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "{{ package_name }}.main:create_app()"]
