[project]
name = "{{ slug }}"
version = "0.1.0"
description = "A Flask full-stack app generated by brupy."
readme = "README.md"
requires-python = ">=3.11"
dependencies = [
    "flask>=3.0.0",
    "pydantic-settings>=2.6.0",
{% if orm == "flask-sqlalchemy" %}
    "flask-sqlalchemy>=3.1.0",
{% elif orm == "sqlalchemy" %}
    "sqlalchemy>=2.0.36",
{% endif %}
{% if database == "postgres" %}
    "psycopg[binary]>=3.1.0",
{% endif %}
{% if migrations and orm == "flask-sqlalchemy" %}
    "flask-migrate>=4.0.0",
{% elif migrations and orm == "sqlalchemy" %}
    "alembic>=1.14.0",
{% endif %}
{% if worker == "celery" %}
    "celery>=5.4.0",
{% endif %}
{% if redis %}
    "redis>=5.2.0",
{% endif %}
{% if docker %}
    "gunicorn>=23.0.0",
{% endif %}
{% if css == "tailwind" %}
    "pytailwindcss>=0.2.0",
{% endif %}
]

[dependency-groups]
dev = [
    "pytest>=8.3.4",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
pythonpath = ["src"]
