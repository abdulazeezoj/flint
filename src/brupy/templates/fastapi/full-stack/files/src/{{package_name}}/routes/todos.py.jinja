"""In-memory Todo store — swapped for a real database when one is chosen
at generation time (see {{ package_name }}/core/db.py)."""

from dataclasses import dataclass
from typing import Annotated

from fastapi import APIRouter, Form, HTTPException, Request
from fastapi.responses import HTMLResponse

from {{ package_name }}.core.config import settings
from {{ package_name }}.core.templates import templates

router = APIRouter()


@dataclass
class Todo:
    id: int
    title: str
    done: bool = False

_todos: dict[int, Todo] = {}
_next_id = 1


@router.get("/", response_class=HTMLResponse)
def index(request: Request) -> HTMLResponse:
    todos = list(_todos.values())
    return templates.TemplateResponse(
        request, "index.html", {"app_name": settings.app_name, "todos": todos}
    )


@router.post("/todos", response_class=HTMLResponse)
def create_todo(request: Request, title: Annotated[str, Form()]) -> HTMLResponse:
    global _next_id
    todo = Todo(id=_next_id, title=title, done=False)
    _todos[_next_id] = todo
    _next_id += 1
    return templates.TemplateResponse(request, "partials/todo_created.html", {"todo": todo})


@router.post("/todos/{todo_id}/toggle", response_class=HTMLResponse)
def toggle_todo(request: Request, todo_id: int) -> HTMLResponse:
    if todo_id not in _todos:
        raise HTTPException(status_code=404, detail="Todo not found")
    todo = _todos[todo_id]
    todo.done = not todo.done
    return templates.TemplateResponse(request, "partials/todo_item.html", {"todo": todo})


@router.delete("/todos/{todo_id}", response_class=HTMLResponse)
def delete_todo(request: Request, todo_id: int) -> HTMLResponse:
    if todo_id not in _todos:
        raise HTTPException(status_code=404, detail="Todo not found")
    del _todos[todo_id]
    if not _todos:
        return templates.TemplateResponse(request, "partials/empty_state.html", {})
    return HTMLResponse("")
